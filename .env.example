# Copy to .env and fill in real values. Never commit .env.

# --- Server (Next.js) ---
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include the database name: /proctra
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/proctra?retryWrites=true&w=majority

# Secret that signs session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=<paste output of: openssl rand -base64 32>

# Teacher account created/updated by `npm run seed` (teachers can't self-register).
SEED_TEACHER_NAME=<teacher display name>
SEED_TEACHER_EMAIL=<teacher@example.com>
SEED_TEACHER_PASSWORD=<8+ character password>

# Cloudinary (camera snapshots, private). Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=<your cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>

# --- Desktop (Electron) ---
# URL the Electron shell loads. Local dev: http://localhost:3000. Production: https://proctra-mu.vercel.app
PROCTRA_APP_URL=http://localhost:3000
