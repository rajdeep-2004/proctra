# Copy to .env and fill in real values. Never commit .env.

# --- Server (Next.js) ---
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include the database name: /proctra
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/proctra?retryWrites=true&w=majority

# --- Desktop (Electron) ---
# URL the Electron shell loads. Local dev: http://localhost:3000. Production: https://proctra-mu.vercel.app
PROCTRA_APP_URL=http://localhost:3000
